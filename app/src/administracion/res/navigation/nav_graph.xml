<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginAdminFragment">

        <!-- P5: chat con la administración (residente) o con un residente (administración) -->
    <fragment
        android:id="@+id/chatFragment"
        android:name="com.example.conjuntoresidencial.ui.chat.ChatFragment"
        tools:layout="@layout/fragment_chat" />

    <!-- P5: detalle de una obra (las dos apps) -->
    <fragment
        android:id="@+id/obraDetalleFragment"
        android:name="com.example.conjuntoresidencial.ui.obras.ObraDetalleFragment"
        tools:layout="@layout/fragment_obra_detalle" />

    <fragment
        android:id="@+id/registrarObraFragment"
        android:name="com.example.conjuntoresidencial.ui.propietario.RegistrarObraFragment"
        tools:layout="@layout/fragment_registrar_obra" />

    <fragment
        android:id="@+id/misObrasFragment"
        android:name="com.example.conjuntoresidencial.ui.propietario.MisObrasFragment"
        tools:layout="@layout/fragment_mis_obras" />

    <!-- P4 bloque 6: "Mi hogar" del residente y, con pendientes=true, los arrendatarios por aprobar -->
    <fragment
        android:id="@+id/residentesFragment"
        android:name="com.example.conjuntoresidencial.ui.residentes.ResidentesFragment"
        tools:layout="@layout/fragment_residentes" />

    <!-- P4 bloque 7: facturación (contador y administrador) y cuentas de la administración -->
    <fragment
        android:id="@+id/cuotasFragment"
        android:name="com.example.conjuntoresidencial.ui.cartera.CuotasFragment"
        tools:layout="@layout/fragment_cuotas" />

    <!-- P5 bloque 3: nueva publicación (administración) -->
    <fragment
        android:id="@+id/publicarFragment"
        android:name="com.example.conjuntoresidencial.ui.feed.PublicarFragment"
        tools:layout="@layout/fragment_publicar" />

    <!-- Pestañas de la barra inferior (MainActivity navega a ellas por id) -->
    <fragment
        android:id="@+id/inicioFragment"
        android:name="com.example.conjuntoresidencial.ui.comun.InicioFragment"
        tools:layout="@layout/fragment_inicio" />

    <fragment
        android:id="@+id/notificacionesFragment"
        android:name="com.example.conjuntoresidencial.ui.comun.NotificacionesFragment"
        tools:layout="@layout/fragment_notificaciones" />

    <fragment
        android:id="@+id/cuentaFragment"
        android:name="com.example.conjuntoresidencial.ui.comun.CuentaFragment"
        tools:layout="@layout/fragment_cuenta" />

    <!-- Reservar una zona con el calendario de disponibilidad (residente) -->
    <fragment
        android:id="@+id/reservarZonaFragment"
        android:name="com.example.conjuntoresidencial.ui.reservas.ReservarZonaFragment"
        tools:layout="@layout/fragment_reservar_zona" />

    <!-- Pantallas de Cuenta (se abren por id desde CuentaFragment) -->
    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.PerfilFragment"
        tools:layout="@layout/fragment_perfil" />

    <fragment
        android:id="@+id/ajustesFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.AjustesFragment"
        tools:layout="@layout/fragment_ajustes" />

    <fragment
        android:id="@+id/permisosFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.PermisosFragment"
        tools:layout="@layout/fragment_permisos" />

    <fragment
        android:id="@+id/legalFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.LegalFragment"
        tools:layout="@layout/fragment_legal" />

    <fragment
        android:id="@+id/documentoFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.DocumentoFragment"
        tools:layout="@layout/fragment_documento" />

    <fragment
        android:id="@+id/ayudaFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.AyudaFragment"
        tools:layout="@layout/fragment_ayuda" />

    <fragment
        android:id="@+id/loginAdminFragment"
        android:name="com.example.conjuntoresidencial.ui.auth.LoginAdminFragment"
        tools:layout="@layout/fragment_login_admin">
        <!-- Al entrar se vacía el historial: "atrás" desde el panel no vuelve al login -->
        <action android:id="@+id/action_loginAdminFragment_to_adminDashboardFragment"
            app:destination="@id/adminDashboardFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.AdminDashboardFragment"
        tools:layout="@layout/fragment_admin_dashboard">
        <action android:id="@+id/action_adminDashboardFragment_to_directorioApartamentosFragment"
            app:destination="@id/directorioApartamentosFragment" />
        <action android:id="@+id/action_adminDashboardFragment_to_controlObrasFragment"
            app:destination="@id/controlObrasFragment" />
        <action android:id="@+id/action_adminDashboardFragment_to_reservasAdminFragment"
            app:destination="@id/reservasAdminFragment" />
        <action android:id="@+id/action_adminDashboardFragment_to_zonasComunesAdminFragment"
            app:destination="@id/zonasComunesAdminFragment" />
        <action android:id="@+id/action_adminDashboardFragment_to_personalObraFragment"
            app:destination="@id/personalObraFragment" />
        <!-- NUEVA ACCIÓN REGISTRADA -->
        <action android:id="@+id/action_adminDashboardFragment_to_carteraAdminFragment"
            app:destination="@id/carteraAdminFragment" />
    </fragment>

    <fragment
        android:id="@+id/directorioApartamentosFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.DirectorioApartamentosFragment"
        tools:layout="@layout/fragment_directorio_apartamentos">
        <action android:id="@+id/action_directorioApartamentosFragment_to_detalleApartamentoFragment"
            app:destination="@id/detalleApartamentoFragment" />
        <!-- Directorio → apartamentos de una torre (la misma pantalla, con el argumento "torre") -->
        <action android:id="@+id/action_directorioApartamentosFragment_to_torre"
            app:destination="@id/directorioApartamentosFragment" />
    </fragment>

    <fragment
        android:id="@+id/detalleApartamentoFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.DetalleApartamentoFragment"
        tools:layout="@layout/fragment_detalle_apartamento" />

    <fragment
        android:id="@+id/controlObrasFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.ControlObrasFragment"
        tools:layout="@layout/fragment_control_obras" />

    <fragment
        android:id="@+id/reservasAdminFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.ReservasAdminFragment"
        tools:layout="@layout/fragment_reservas_admin" />

    <fragment
        android:id="@+id/zonasComunesAdminFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.ZonasComunesAdminFragment"
        tools:layout="@layout/fragment_zonas_comunes_admin" />

    <!-- PERSONAL DE OBRA -->
    <fragment
        android:id="@+id/personalObraFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.PersonalObraFragment"
        tools:layout="@layout/fragment_personal_obra" />

    <!-- NUEVO DESTINO: CARTERA DE ADMINISTRACIÓN -->
    <fragment
        android:id="@+id/carteraAdminFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.CarteraAdminFragment"
        tools:layout="@layout/fragment_cartera_admin"
        tools:label="CarteraAdminFragment" />

    <fragment
        android:id="@+id/conversacionesFragment"
        android:name="com.example.conjuntoresidencial.ui.chat.ConversacionesFragment"
        tools:layout="@layout/fragment_equipo" />

    <!-- P5: cartera de la administración (estadísticas y solicitudes del contador) -->
    <fragment
        android:id="@+id/carteraResumenFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.CarteraResumenFragment"
        tools:layout="@layout/fragment_cartera_resumen" />

    <fragment
        android:id="@+id/equipoFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.EquipoFragment"
        tools:layout="@layout/fragment_equipo" />

    <!-- P5 bloque 4: parqueaderos (administración) -->
    <fragment
        android:id="@+id/parqueaderosFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.ParqueaderosFragment"
        tools:layout="@layout/fragment_parqueaderos" />

    <!-- P5 bloque 5: editor visual de zonas comunes -->
    <fragment
        android:id="@+id/editarZonaFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.EditarZonaFragment"
        tools:layout="@layout/fragment_editar_zona" />

    <!-- Vehículos por aprobar y cupos (administrador) -->
    <fragment
        android:id="@+id/vehiculosAdminFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.VehiculosAdminFragment"
        tools:layout="@layout/fragment_vehiculos_admin" />

</navigation>
