<?xml version="1.0" encoding="utf-8"?>
<!-- P7: la app de plataforma. Login, conjuntos (crear, editar, suspender, restablecer el
     principal) y auditoría. P10: barra inferior con Panel, Conjuntos y Auditoría; sin avisos del celular. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginPlataformaFragment">

    <!-- P8 bloque 2: primeros pasos antes del login (util/PrimerosPasos.kt) -->
    <fragment
        android:id="@+id/bienvenidaFragment"
        android:name="com.example.conjuntoresidencial.ui.auth.BienvenidaFragment"
        android:label="Bienvenida" />

    <fragment
        android:id="@+id/loginPlataformaFragment"
        android:name="com.example.conjuntoresidencial.ui.plataforma.LoginPlataformaFragment"
        tools:layout="@layout/fragment_login_plataforma" />

    <!-- P8 bloque 6: lo primero tras el login; los conjuntos, su detalle y la auditoría se abren desde aquí -->
    <fragment
        android:id="@+id/panelPlataformaFragment"
        android:name="com.example.conjuntoresidencial.ui.plataforma.PanelPlataformaFragment"
        tools:layout="@layout/fragment_panel_plataforma" />

    <fragment
        android:id="@+id/conjuntoDetalleFragment"
        android:name="com.example.conjuntoresidencial.ui.plataforma.ConjuntoDetalleFragment"
        tools:layout="@layout/fragment_conjunto_detalle">
        <argument
            android:name="conjuntoId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/conjuntosPlataformaFragment"
        android:name="com.example.conjuntoresidencial.ui.plataforma.ConjuntosPlataformaFragment"
        tools:layout="@layout/fragment_conjuntos_plataforma" />

    <!-- conjuntoId: solo lo de ese conjunto; sin él, todo -->
    <fragment
        android:id="@+id/auditoriaPlataformaFragment"
        android:name="com.example.conjuntoresidencial.ui.plataforma.AuditoriaPlataformaFragment"
        tools:layout="@layout/fragment_auditoria_plataforma">
        <argument
            android:name="conjuntoId"
            android:defaultValue="0L"
            app:argType="long" />
        <argument
            android:name="titulo"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <!-- P10: una operación de la auditoría con todo su detalle -->
    <fragment
        android:id="@+id/eventoPlataformaFragment"
        android:name="com.example.conjuntoresidencial.ui.plataforma.EventoPlataformaFragment"
        tools:layout="@layout/fragment_evento_plataforma" />
</navigation>
