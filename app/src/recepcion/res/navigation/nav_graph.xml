<?xml version="1.0" encoding="utf-8"?>
<!-- P7 bloque 4: la app de la recepción. Login de la cuenta de portería, turno con el PIN de cada
     guardia (también la pantalla de bloqueo), la portería y la cuenta. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginAdminFragment">

    <!-- P8 bloque 2: primeros pasos antes del login (util/PrimerosPasos.kt) -->
    <fragment
        android:id="@+id/bienvenidaFragment"
        android:name="com.example.conjuntoresidencial.ui.auth.BienvenidaFragment"
        android:label="Bienvenida" />

    <fragment
        android:id="@+id/elegirConjuntoFragment"
        android:name="com.example.conjuntoresidencial.ui.auth.ElegirConjuntoFragment"
        android:label="Elegir conjunto" />

    <fragment
        android:id="@+id/loginAdminFragment"
        android:name="com.example.conjuntoresidencial.ui.auth.LoginAdminFragment"
        tools:layout="@layout/fragment_login_admin" />

    <fragment
        android:id="@+id/turnoFragment"
        android:name="com.example.conjuntoresidencial.ui.recepcion.TurnoFragment"
        tools:layout="@layout/fragment_turno" />

    <fragment
        android:id="@+id/porteriaFragment"
        android:name="com.example.conjuntoresidencial.ui.admin.PorteriaFragment"
        tools:layout="@layout/fragment_porteria" />

    <!-- Pestaña Cuenta y sus pantallas (se abren por id desde CuentaFragment) -->
    <fragment
        android:id="@+id/cuentaFragment"
        android:name="com.example.conjuntoresidencial.ui.comun.CuentaFragment"
        tools:layout="@layout/fragment_cuenta" />

    <fragment
        android:id="@+id/perfilFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.PerfilFragment"
        tools:layout="@layout/fragment_perfil" />

    <fragment
        android:id="@+id/dispositivosFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.DispositivosFragment"
        tools:layout="@layout/fragment_dispositivos" />

    <fragment
        android:id="@+id/ajustesFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.AjustesFragment"
        tools:layout="@layout/fragment_ajustes" />

    <fragment
        android:id="@+id/permisosFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.PermisosFragment"
        tools:layout="@layout/fragment_permisos" />

    <fragment
        android:id="@+id/legalFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.LegalFragment"
        tools:layout="@layout/fragment_legal" />

    <fragment
        android:id="@+id/documentoFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.DocumentoFragment"
        tools:layout="@layout/fragment_documento" />

    <fragment
        android:id="@+id/ayudaFragment"
        android:name="com.example.conjuntoresidencial.ui.cuenta.AyudaFragment"
        tools:layout="@layout/fragment_ayuda" />

    <fragment
        android:id="@+id/notificacionesFragment"
        android:name="com.example.conjuntoresidencial.ui.comun.NotificacionesFragment"
        tools:layout="@layout/fragment_notificaciones" />
</navigation>
