<?xml version="1.0" encoding="utf-8"?>
<!-- Barra inferior en Android 13+: cápsula translúcida neutra. El contenido que pasa por
     debajo ya llega difuminado (DifuminadoProgresivo), así que la barra no desenfoca. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/barra_translucida" />
    <corners android:radius="40dp" />
    <stroke
        android:width="1dp"
        android:color="@color/borde_barra" />
</shape>
