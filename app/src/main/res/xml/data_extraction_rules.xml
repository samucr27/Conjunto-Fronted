<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de copia de seguridad para Android 12+.
   La sesión (token JWT) nunca debe salir del dispositivo: ni a la nube
   ni al pasar los datos a un teléfono nuevo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="residencial_session.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="residencial_session.xml"/>
    </device-transfer>
</data-extraction-rules>
