<?xml version="1.0" encoding="utf-8"?>
<!-- Pestaña Cuenta (estilo ajustes de One UI): acceso a Perfil, Ajustes, Permisos, Legal,
     Ayuda y Acerca de, y el botón para cerrar sesión.
     Encabezado One UI (layout/encabezado_grande.xml) y, debajo, la hoja con las opciones
     (ui/comun/FilaOpcion.kt). Generado con el mismo esquema que las demás pantallas de Cuenta. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <include
            android:id="@+id/encabezado"
            layout="@layout/encabezado_grande" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fondo_hoja"
            app:behavior_overlapTop="28dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:id="@+id/contenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaPerfil"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_person"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/cuenta_perfil"
                            app:filaSubtitulo="@string/cuenta_perfil_sub" />
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp" />
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaAjustes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_settings"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/cuenta_ajustes"
                            app:filaSubtitulo="@string/cuenta_ajustes_sub" />
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp" />
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaPermisos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_security"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/cuenta_permisos"
                            app:filaSubtitulo="@string/cuenta_permisos_sub" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaLegal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_description"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/cuenta_legal"
                            app:filaSubtitulo="@string/cuenta_legal_sub" />
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp" />
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaAyuda"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_help"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/cuenta_ayuda"
                            app:filaSubtitulo="@string/cuenta_ayuda_sub" />
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp" />
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaAcercaDe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_info"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/cuenta_acerca_de" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesion"
                    style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:minHeight="56dp"
                    android:text="@string/cerrar_sesion"
                    android:textColor="?attr/colorError"
                    app:icon="@drawable/ic_logout"
                    app:iconTint="?attr/colorError"
                    app:strokeColor="?attr/colorError" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
