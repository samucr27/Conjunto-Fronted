<?xml version="1.0" encoding="utf-8"?>
<!-- Un día del calendario de reservas: el número dentro de un círculo del color de su
     disponibilidad (libre, parcial, lleno) y, si es el elegido, con borde. Lo arma DiaAdapter. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/celdaDia"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvNumeroDia"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceLabelLarge" />
</FrameLayout>
