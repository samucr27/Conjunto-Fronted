<?xml version="1.0" encoding="utf-8"?>
<!-- P8 bloque 3: la visita en portería a pantalla completa, como una alarma.
     P10: diseño de llamada entrante: anillo con el tiempo que queda, tarjeta con el visitante,
     botones redondos grandes para rechazar y aceptar. P10 bloque 7: la foto del visitante en el centro. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_alarma_visita"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/raiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="48dp"
        android:paddingEnd="28dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarma_encabezado"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="#CCFFFFFF" />

        <TextView
            android:id="@+id/tvConjunto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="#B3FFFFFF"
            android:visibility="gone" />

        <!-- El anillo se vacía mientras pasa el tiempo para responder -->
        <FrameLayout
            android:layout_width="296dp"
            android:layout_height="296dp"
            android:layout_marginTop="28dp">

            <View
                android:id="@+id/pulso"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/fondo_punto_bienvenida" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/anilloTiempo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="1000"
                android:progress="1000"
                app:indicatorColor="@android:color/white"
                app:indicatorSize="282dp"
                app:trackColor="#33FFFFFF"
                app:trackCornerRadius="4dp"
                app:trackThickness="6dp" />

            <!-- P10 bloque 7: la foto de la cara que tomó la portería (o el ícono si no hay foto) -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgVisitante"
                android:layout_width="262dp"
                android:layout_height="262dp"
                android:layout_gravity="center"
                android:background="@drawable/fondo_punto_bienvenida"
                android:importantForAccessibility="no"
                android:padding="80dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_people"
                app:shapeAppearanceOverlay="@style/FormaCirculo"
                app:tint="@android:color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAmpliarFoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/foto_toca_ampliar"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="#CCFFFFFF"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTiempo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@android:color/white" />

        <!-- Quién llegó -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/fondo_tarjeta_alarma"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@android:color/white"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetalle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="#E6FFFFFF" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <!-- Botones redondos de llamada entrante -->
        <LinearLayout
            android:id="@+id/grupoBotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRechazar"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/porteria_rechazar"
                    app:backgroundTint="#E53935"
                    app:icon="@drawable/ic_close"
                    app:iconSize="36dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    app:iconTint="@android:color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/porteria_rechazar"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@android:color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_horizontal"
                android:orientation="vertical">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutorizar"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/porteria_autorizar"
                    app:backgroundTint="#43A047"
                    app:icon="@drawable/ic_check_circle"
                    app:iconSize="36dp"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    app:iconTint="@android:color/white" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="@string/porteria_autorizar"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChatPorteria"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/chat_visita_abrir"
            android:textColor="@color/colorPrimary"
            android:visibility="gone"
            app:backgroundTint="@android:color/white"
            app:icon="@drawable/ic_chat"
            app:iconGravity="textStart"
            app:iconTint="@color/colorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirApp"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="@string/alarma_abrir_app"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
