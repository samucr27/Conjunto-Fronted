<?xml version="1.0" encoding="utf-8"?>
<!-- Registrar o editar una zona común (ZonasComunesAdminFragment): datos, si se puede reservar y,
     para las reservables, el aforo y el horario en que se reservan. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNombreZona"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/zona_nombre">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNombreZona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/zona_estado">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEstadoZona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="@string/zona_descripcion">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etDescripcionZona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences|textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <CheckBox
        android:id="@+id/cbEsReservable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/zona_reservable_pregunta" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAforo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:hint="@string/zona_aforo"
        app:helperText="@string/zona_aforo_ayuda">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAforo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="4" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Horario para reservar: se elige con el reloj; la papelera lo quita (sin horario = todo el día) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilApertura"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:hint="@string/zona_apertura"
        app:endIconContentDescription="@string/zona_quitar_hora"
        app:endIconDrawable="@drawable/ic_delete"
        app:endIconMode="custom">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etApertura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCierre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="@string/zona_cierre"
        app:endIconContentDescription="@string/zona_quitar_hora"
        app:endIconDrawable="@drawable/ic_delete"
        app:endIconMode="custom"
        app:helperText="@string/zona_horario_ayuda">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCierre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
</ScrollView>
