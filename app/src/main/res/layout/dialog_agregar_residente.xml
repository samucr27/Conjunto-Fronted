<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNombreResidente"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/residente_nombre"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNombreResidente"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/residente_telefono"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTelefonoResidente"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="phone"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/residente_identificacion"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="12dp">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIdentificacionResidente"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="number"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Lista cerrada: el backend solo acepta PROPIETARIO o ARRENDATARIO.
         El propietario solo agrega arrendatarios: ahí se oculta -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTipoResidente"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="@string/residente_tipo"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        app:endIconContentDescription="@string/mostrar_opciones">
        <AutoCompleteTextView
            android:id="@+id/etTipoResidente"
            tools:ignore="LabelFor"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="none"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Solo cuando lo agrega el propietario: con ella entrará con su documento -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilContrasenaResidente"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/residente_contrasena"
        android:visibility="gone"
        app:endIconContentDescription="@string/mostrar_contrasena"
        app:endIconMode="password_toggle"
        app:helperText="@string/residente_contrasena_ayuda">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etContrasenaResidente"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>