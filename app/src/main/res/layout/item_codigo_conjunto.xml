<?xml version="1.0" encoding="utf-8"?>
<!-- P9 bloque 2: el código del conjunto de hoy, para dárselo en persona a los residentes
     (administración y portería; ui/comun/CodigoDelDia.kt lo carga) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_key"
            app:tint="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/codigo_hoy_titulo"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnPrimaryContainer" />
            <TextView
                android:id="@+id/tvCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textAppearance="?attr/textAppearanceHeadlineMedium"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvCambia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnPrimaryContainer" />
        </LinearLayout>

        <!-- P10: el código está oculto hasta tocar el ojo (y se vuelve a ocultar solo) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerCodigo"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/codigo_mostrar"
            app:icon="@drawable/ic_visibility"
            app:iconSize="26dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
