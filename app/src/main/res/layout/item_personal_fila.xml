<?xml version="1.0" encoding="utf-8"?>
<!-- Fila sencilla de un trabajador (nombre, cédula y ARL) para listas dentro de diálogos -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/tvNombreFila"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tvCedulaFila"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <!-- Etiqueta de ARL (ChipEstado); debajo y no al lado, para no cortar el nombre con letra grande -->
    <TextView
        android:id="@+id/tvArlFila"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

</LinearLayout>
