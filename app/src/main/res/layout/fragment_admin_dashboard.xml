<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Panel One UI: encabezado grande (layout/encabezado_grande.xml) y, debajo, la hoja con
         las tarjetas (layout/item_tarjeta_menu.xml). Textos, íconos y acciones se asignan en el fragment. -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <include
            android:id="@+id/encabezado"
            layout="@layout/encabezado_grande" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fondo_hoja"
            app:behavior_overlapTop="28dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:paddingStart="12dp"
                android:paddingTop="20dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp"
                android:useDefaultMargins="false">

                <include
                    android:id="@+id/cardDirectorioAptos"
                    layout="@layout/item_tarjeta_menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp" />
                <include
                    android:id="@+id/cardControlObras"
                    layout="@layout/item_tarjeta_menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp" />
                <include
                    android:id="@+id/cardHistorialReservas"
                    layout="@layout/item_tarjeta_menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp" />
                <include
                    android:id="@+id/cardZonasAdmin"
                    layout="@layout/item_tarjeta_menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp" />
                <include
                    android:id="@+id/cardPersonalObra"
                    layout="@layout/item_tarjeta_menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp" />
                <include
                    android:id="@+id/cardCarteraAdmin"
                    layout="@layout/item_tarjeta_menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp" />
                <include
                    android:id="@+id/cardVehiculosAdmin"
                    layout="@layout/item_tarjeta_menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp" />
                <include
                    android:id="@+id/cardResidentesPendientes"
                    layout="@layout/item_tarjeta_menu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_margin="6dp" />
            </GridLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
