<?xml version="1.0" encoding="utf-8"?>
<!-- Cuenta → Legal: términos, privacidad y licencias (cada uno abre DocumentoFragment).
     Encabezado One UI (layout/encabezado_grande.xml) y, debajo, la hoja con las opciones
     (ui/comun/FilaOpcion.kt). Generado con el mismo esquema que las demás pantallas de Cuenta. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <include
            android:id="@+id/encabezado"
            layout="@layout/encabezado_grande" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fondo_hoja"
            app:behavior_overlapTop="28dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:id="@+id/contenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Material3.CardView.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaTerminos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_description"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/legal_terminos"
                            app:filaSubtitulo="@string/legal_terminos_sub" />
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp" />
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaPrivacidad"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_security"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/legal_privacidad"
                            app:filaSubtitulo="@string/legal_privacidad_sub" />
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp" />
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaLicencias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_info"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/legal_licencias"
                            app:filaSubtitulo="@string/legal_licencias_sub" />
                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp" />
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaMisDatos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:filaIcono="@drawable/ic_person"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/legal_mis_datos"
                            app:filaSubtitulo="@string/legal_mis_datos_sub" />
                        <com.google.android.material.divider.MaterialDivider
                            android:id="@+id/divisorSolicitudes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="72dp"
                            android:visibility="gone" />
                        <com.example.conjuntoresidencial.ui.comun.FilaOpcion
                            android:id="@+id/filaSolicitudesDatos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:filaIcono="@drawable/ic_info"
                            app:filaTipo="enlace"
                            app:filaTitulo="@string/datos_solicitudes_admin"
                            app:filaSubtitulo="@string/legal_solicitudes_admin_sub" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:id="@+id/tvNotaLegal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:text="@string/legal_nota"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
