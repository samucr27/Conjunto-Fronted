<?xml version="1.0" encoding="utf-8"?>
<!-- La app dibuja de borde a borde (obligatorio desde Android 15). MainActivity
     ajusta la altura de vistaBarraEstado y los márgenes del contenido según las
     barras del sistema, para que nada quede debajo de ellas. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Franja detrás de la barra de estado: el morado de la marca, como los encabezados -->
    <View
        android:id="@+id/vistaBarraEstado"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/colorPrimary"
        android:importantForAccessibility="no" />

    <fragment
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

</LinearLayout>
