<?xml version="1.0" encoding="utf-8"?>
<!-- La app dibuja de borde a borde (obligatorio desde Android 15): el contenido llega hasta
     arriba (detrás de la barra de estado) y hasta abajo. Encima flotan dos capas translúcidas
     que desenfocan lo que pasa por debajo (BlurView, Android 12+; antes, un degradado):
       - arriba, la franja con los botones redondos "volver" y "⋮" (ui/comun/ControlesFlotantes);
       - abajo, la barra de pestañas, solo en las pantallas principales.
     MainActivity ajusta sus márgenes según las barras del sistema. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Lo que se desenfoca: todas las pantallas -->
    <eightbitlab.com.blurview.BlurTarget
        android:id="@+id/contenedor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_graph" />
    </eightbitlab.com.blurview.BlurTarget>

    <!-- Franja superior difuminada: aparece cuando el encabezado sale de la pantalla -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/franjaSuperior"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Botones flotantes de arriba (se configuran desde cada pantalla) -->
    <FrameLayout
        android:id="@+id/botonesSuperiores"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="top"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolver"
            style="@style/Widget.App.BotonRedondo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:contentDescription="@string/volver"
            app:icon="@drawable/ic_arrow_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMas"
            style="@style/Widget.App.BotonRedondo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/mas_opciones"
            app:icon="@drawable/ic_more_vert" />
    </FrameLayout>

    <!-- Barra inferior flotante (estilo One UI): cápsula translúcida que desenfoca el contenido
         que pasa por debajo, separada de los bordes -->
    <eightbitlab.com.blurview.BlurView
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/fondo_barra_inferior"
        android:visibility="gone">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/navInferior"
            style="@style/Widget.App.NavInferior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </eightbitlab.com.blurview.BlurView>

    <!-- Acción principal de la pantalla (Registrar zona, Agregar vehículo, Registrar obra):
         está fuera de "contenedor", así que flota nítida encima del difuminado de abajo.
         La muestra cada pantalla con ControlesFlotantes.mostrarBotonFlotante. -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/botonFlotante"
        style="@style/Widget.App.BotonFlotante"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <!-- Avisos breves (Snackbar) de todas las pantallas: encima del contenido difuminado, de la
         barra y del botón flotante. No recibe toques (solo el aviso). Ver ui/comun/Avisos.kt -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/capaAvisos"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Carga inicial: el logo se dibuja sobre el morado de la pantalla de inicio y luego se
         desvanece (MainActivity.mostrarLogoAnimado). Tapa y bloquea todo mientras tanto
         (clickable solo para tragarse los toques; no es un control). -->
    <FrameLayout
        android:id="@+id/capaInicio"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ic_launcher_background"
        android:clickable="true"
        android:focusable="false"
        android:visibility="gone"
        tools:ignore="KeyboardInaccessibleWidget">

        <ImageView
            android:id="@+id/imgLogoInicio"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_animado" />
    </FrameLayout>

</FrameLayout>
