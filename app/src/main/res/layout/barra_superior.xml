<!-- Barra superior común. Uso en un layout:
       <include android:id="@+id/barra" layout="@layout/barra_superior" />
     y en el fragment: configurarBarra(binding.barra.toolbar, R.string.titulo, R.string.subtitulo)
     Ver util/BarraSuperior.kt -->
<com.google.android.material.appbar.MaterialToolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    style="@style/Widget.App.BarraSuperior"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />
