<?xml version="1.0" encoding="utf-8"?>
<!-- Cuenta → Ayuda: preguntas frecuentes (AyudaFragment las arma desde strings.xml).
     Encabezado One UI (layout/encabezado_grande.xml) y, debajo, la hoja con las opciones
     (ui/comun/FilaOpcion.kt). Generado con el mismo esquema que las demás pantallas de Cuenta. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface">

        <include
            android:id="@+id/encabezado"
            layout="@layout/encabezado_grande" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/fondo_hoja"
            app:behavior_overlapTop="28dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:id="@+id/contenido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
