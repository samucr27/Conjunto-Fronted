<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado estilo One UI. Uso en un CoordinatorLayout:
       <include android:id="@+id/encabezado" layout="@layout/encabezado_grande" />
     y el contenido con app:layout_behavior="@string/appbar_scrolling_view_behavior".
     Arriba (~40 % de la pantalla) van el título grande y un resumen; al deslizar el contenido,
     el encabezado se pliega a una barra con el título pequeño. Los botones "volver" y "⋮"
     son círculos que flotan sobre el morado. Ver ui/comun/EncabezadoGrande.kt -->
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimary"
    android:stateListAnimator="@null"
    app:elevation="0dp"
    app:liftOnScroll="false"
    app:liftOnScrollColor="@color/colorPrimary">
    <!-- liftOnScrollColor: al plegarse, Material 3 marca la barra como elevada y le cambia
         el fondo a ese color (gris por defecto); se deja el mismo morado. -->

    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:id="@+id/colapsable"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:minHeight="100dp"
        app:contentScrim="@android:color/transparent"
        app:statusBarScrim="@android:color/transparent"
        app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
        app:titleEnabled="false">
        <!-- minHeight 100 = barra de 72 + los 28 dp en que la hoja de contenido se monta encima
             (behavior_overlapTop): así, plegado, la hoja no tapa los botones.
             contentScrim transparente: sin Toolbar se pintaría encima de los botones (y Material 3
             pone uno gris por defecto); el morado lo da el fondo del AppBarLayout. -->

        <!-- Información: título grande, resumen y descripción -->
        <LinearLayout
            android:id="@+id/zonaInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="64dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp"
            app:layout_collapseMode="parallax"
            app:layout_collapseParallaxMultiplier="0.5">

            <TextView
                android:id="@+id/tvTituloGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.App.HeadlineLarge"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/barra_subtitulo"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Barra fija: botones redondos y título pequeño (aparece al plegar) -->
        <FrameLayout
            android:id="@+id/barraCompacta"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_gravity="top"
            app:layout_collapseMode="pin">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVolver"
                style="@style/Widget.App.BotonRedondo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/volver"
                android:visibility="gone"
                app:icon="@drawable/ic_arrow_back" />

            <!-- Para TalkBack basta el título grande: este es solo visual -->
            <TextView
                android:id="@+id/tvTituloCompacto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="76dp"
                android:layout_marginEnd="76dp"
                android:alpha="0"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/white" />

            <LinearLayout
                android:id="@+id/accionesDerecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:orientation="horizontal">

                <!-- Acción opcional de la pantalla (por ejemplo, notificaciones en el panel) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAccion"
                    style="@style/Widget.App.BotonRedondo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMas"
                    style="@style/Widget.App.BotonRedondo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/mas_opciones"
                    android:visibility="gone"
                    app:icon="@drawable/ic_more_vert" />
            </LinearLayout>
        </FrameLayout>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
</com.google.android.material.appbar.AppBarLayout>
