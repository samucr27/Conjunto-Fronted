<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado estilo One UI. Uso en un CoordinatorLayout:
       <include android:id="@+id/encabezado" layout="@layout/encabezado_grande" />
     y el contenido con app:layout_behavior="@string/appbar_scrolling_view_behavior".
     Arriba (~40 % de la pantalla, desde detrás de la barra de estado) van el título grande,
     un resumen y la descripción. Al deslizar el contenido, el encabezado sale de la pantalla
     por completo; arriba solo quedan la franja difuminada y los botones flotantes
     (activity_main.xml). Vuelve a aparecer al regresar al inicio del contenido.
     Ver ui/comun/EncabezadoGrande.kt -->
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorPrimary"
    android:stateListAnimator="@null"
    app:elevation="0dp"
    app:liftOnScroll="false"
    app:liftOnScrollColor="@color/colorPrimary">
    <!-- liftOnScrollColor: al desplazarse, Material 3 marca la barra como elevada y le cambia
         el fondo a ese color (gris por defecto); se deja el mismo morado. -->

    <com.google.android.material.appbar.CollapsingToolbarLayout
        android:id="@+id/colapsable"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        app:contentScrim="@android:color/transparent"
        app:layout_scrollFlags="scroll|snap"
        app:statusBarScrim="@android:color/transparent"
        app:titleEnabled="false">
        <!-- Sin exitUntilCollapsed: el encabezado sale entero de la pantalla.
             contentScrim transparente: Material 3 pone uno gris por defecto. -->

        <!-- Información: título grande, resumen y descripción. El margen de arriba
             (barra de estado + fila de botones) lo pone EncabezadoGrande.kt -->
        <LinearLayout
            android:id="@+id/zonaInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp"
            app:layout_collapseMode="parallax"
            app:layout_collapseParallaxMultiplier="0.5">

            <TextView
                android:id="@+id/tvTituloGrande"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="@style/TextAppearance.App.HeadlineLarge"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/tvInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="@color/white"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvDescripcion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/barra_subtitulo"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.appbar.CollapsingToolbarLayout>
</com.google.android.material.appbar.AppBarLayout>
